<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a yen/yuan glyph drawn as geometry rather than text, so it stays
  identical across devices with no font dependency. Gold is Palette.Gold.
  The 0.92 group scale keeps every vertex inside the 66dp circle that adaptive
  icon masks guarantee to be visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.92"
        android:scaleY="0.92">
        <!-- Arms and stem. -->
        <path
            android:fillColor="#8AB4F8"
            android:pathData="M32,29 L41.3,29 L54,43.62 L66.7,29 L76,29 L57.5,50.3 L57.5,78.5 L50.5,78.5 L50.5,50.3 Z" />
        <!-- Upper crossbar. -->
        <path
            android:fillColor="#8AB4F8"
            android:pathData="M33,55.5 L75,55.5 L75,61.5 L33,61.5 Z" />
        <!-- Lower crossbar. -->
        <path
            android:fillColor="#8AB4F8"
            android:pathData="M33,66.5 L75,66.5 L75,72.5 L33,72.5 Z" />
    </group>
</vector>
