<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Charcoal ink so the icon reads as a deliberate dark
  tile rather than a hole on a dark wallpaper; the diagonal lift is the same
  Ink -> Surface step the app uses between its background and its cards.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="0"
                android:endX="102"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF1B1B22" />
                <item android:offset="0.55" android:color="#FF101014" />
                <item android:offset="1.0" android:color="#FF08080A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
